BOT_TOKEN=INSIRA_O_TOKEN_DO_BOT_AQUI
MAX_WORKERS=3
LOW_MEMORY=false

# Opcional. Alguns conteúdos do Instagram exigem autenticação.
# Use um arquivo cookies.txt no formato Netscape/Mozilla.
INSTAGRAM_COOKIES_FILE=secrets/instagram-cookies.txt

# Opcional: fotos JPEG 85 / até 1920 px e vídeos até 1280 px.
REDUCE_MEDIA=false

# Cobalt local opcional, primeira tentativa sem cookies. Vazio desativa.
COBALT_API_URL=http://127.0.0.1:9000/

# Opcional: cookies do X em formato Netscape; usados no fallback do yt-dlp.
X_COOKIES_FILE=secrets/x-cookies.txt
